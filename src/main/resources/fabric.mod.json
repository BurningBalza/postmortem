{
	"schemaVersion": 1,
	"id": "postmortem",
	"version": "${version}",
	"name": "Postmortem",
	"description": "A mod that explores the concepts of death in Minecraft, and acts to change it for the better.",
	"authors": [
		"Burning & Kindling"
	],
	"license": "ARR",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.burning.postmortem.fabric.PostmortemFabric"
		],
		"client": [
			"dev.burning.postmortem.fabric.PostmortemFabricClient"
		]
	},
	"mixins": [
		"postmortem.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	},
	"suggests": {
		"backslot": "*",
		"combatamenities": "*",
		"pehkui": "*",
		"trinkets": "*"
	}
}
